{
  "name": "vue-mobile-editor",
  "version": "0.1.0",
  "description": "Mobile-first rich text editor for H5, built on Tiptap 2. Supports Vue 2, Vue 3 and uni-app (H5).",
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "tiptap",
    "vue",
    "vue2",
    "vue3",
    "uni-app",
    "h5",
    "mobile"
  ],
  "license": "MIT",
  "author": "fengyang <mrsimayang@163.com>",
  "main": "dist/vue2/index.common.js",
  "module": "dist/vue2/index.esm.js",
  "unpkg": "dist/vue2/index.umd.min.js",
  "jsdelivr": "dist/vue2/index.umd.min.js",
  "exports": {
    ".": {
      "import": "./dist/vue2/index.esm.js",
      "require": "./dist/vue2/index.common.js"
    },
    "./vue2": {
      "import": "./dist/vue2/index.esm.js",
      "require": "./dist/vue2/index.common.js"
    },
    "./vue3": {
      "import": "./dist/vue3/index.esm.js",
      "require": "./dist/vue3/index.common.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/MobileEditor.vue",
    "src/index.js",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "dev": "rollup -c -w",
    "demo": "npm run build && python -m http.server 5178",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.9",
    "@tiptap/extension-bubble-menu": "^2.11.9",
    "@tiptap/extension-color": "^2.11.9",
    "@tiptap/extension-floating-menu": "^2.11.9",
    "@tiptap/extension-highlight": "^2.11.9",
    "@tiptap/extension-image": "^2.11.9",
    "@tiptap/extension-placeholder": "^2.11.9",
    "@tiptap/extension-table": "^2.11.9",
    "@tiptap/extension-table-cell": "^2.11.9",
    "@tiptap/extension-table-header": "^2.11.9",
    "@tiptap/extension-table-row": "^2.11.9",
    "@tiptap/extension-task-item": "^2.11.9",
    "@tiptap/extension-task-list": "^2.11.9",
    "@tiptap/extension-text-align": "^2.11.9",
    "@tiptap/extension-text-style": "^2.11.9",
    "@tiptap/extension-underline": "^2.11.9",
    "@tiptap/pm": "^2.11.9",
    "@tiptap/starter-kit": "^2.11.9"
  },
  "peerDependencies": {
    "vue": "^2.6.14 || ^3.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-replace": "^5.0.7",
    "@tiptap/vue-2": "^2.11.9",
    "@tiptap/vue-3": "^2.11.9",
    "@vue/compiler-sfc": "^3.5.13",
    "rimraf": "^3.0.2",
    "rollup": "^2.79.2",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-vue": "^5.1.9",
    "rollup-plugin-vue3": "npm:rollup-plugin-vue@^6.0.0",
    "sass": "1.32.13",
    "vue": "2.6.14",
    "vue-template-compiler": "2.6.14",
    "vue3": "npm:vue@^3.5.13"
  },
  "engines": {
    "node": ">=14"
  }
}
